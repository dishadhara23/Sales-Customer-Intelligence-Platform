# ---------------------------------------------------------------------------
# Sales & Customer Intelligence Platform — environment configuration
# Copy to `.env` and fill in.  `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Warehouse -------------------------------------------------------------
# Primary target is PostgreSQL. If DATABASE_URL is unset OR unreachable, the
# pipeline transparently falls back to a local SQLite file so the project runs
# end-to-end with zero setup (see src/config.py).
#
# Local Postgres via the bundled docker-compose.yml:
DATABASE_URL=postgresql+psycopg2://olist:olist@localhost:5432/olist

# Force the SQLite fallback even when Postgres is reachable (useful for CI):
# WAREHOUSE_BACKEND=sqlite

# Path used by the SQLite fallback.
SQLITE_PATH=data/processed/olist.db


# --- Display currency ------------------------------------------------------
# The warehouse always stores Brazilian Real (the source data is a Brazilian
# marketplace). This controls display only, and converted figures are always
# labelled. Set to BRL to show the source values unconverted.
# One of: GBP | USD | EUR | BRL
DISPLAY_CURRENCY=GBP


# --- LLM "ask your data" chatbot -------------------------------------------
# Which backend writes the SQL. "auto" tries Ollama (free, local) then Claude.
# One of: auto | ollama | claude | none
# "none" forces the built-in query builder, which needs no model at all.
LLM_PROVIDER=auto

# Ollama (free, local). Install: see docs/CHATBOT_SETUP.md
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434

# Claude (optional, paid). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for natural-language -> SQL translation.
ANTHROPIC_MODEL=claude-opus-5

# Reasoning depth: low | medium | high | xhigh | max
# `medium` is a good latency/quality balance for text-to-SQL.
ANTHROPIC_EFFORT=medium

# Hard row cap applied to every generated query (defence in depth).
SQL_ROW_LIMIT=1000
